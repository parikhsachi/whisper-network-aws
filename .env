AWS_REGION=us-west-2

# Clean Rooms membership you run queries against
CLEANROOMS_MEMBERSHIP_ID=f04ca1f9-8a5a-478d-8983-4e8f5c368ec0

# Results destination (must be writable by the result-receiver role configured for the collab)
CLEANROOMS_RESULTS_BUCKET=my-results-bucket
CLEANROOMS_RESULTS_PREFIX=cleanrooms/results

# DynamoDB table for job state
QUERY_JOBS_TABLE=spy-query-jobs

# Optional: if you want to force a profile locally
AWS_PROFILE=tape-main

AWS_REGION=us-west-2

# Clean Rooms collaboration id (the one you see in console/CLI)
CLEANROOMS_COLLAB_ID=YOUR_COLLAB_ID

# Membership results destination (bucket + prefix you configured)
RESULTS_BUCKET=YOUR_RESULTS_BUCKET
